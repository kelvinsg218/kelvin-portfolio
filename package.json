{
  "name": "kelvin-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive personal portfolio showcasing my journey in technology, software projects and creative development.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "verify": "node scripts/verify.mjs",
    "promo": "node scripts/build-promo.mjs"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "playwright-core": "^1.49.1",
    "sharp": "0.33.5",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true
  },
  "engines": {
    "node": ">=20"
  }
}
